ementsTrue: [ { $map: { input: '$atividades', as: 'a',) Tj T* (                                             in: { $gt: ['$$a.horaFim', '$$a.horaInicio'] } } } ] } }) Tj T* (  ] }) Tj T* (}\);) Tj T*  T* (// -----------------------------------------------------------------------------) Tj T* (// 3. planos_alimentares  \(classes PlanoAlimentar + Refeicao, composi\001\002o 1..*\) - refei\001\007es EMBUTIDAS) Tj T* (// -----------------------------------------------------------------------------) Tj T* (bd.createCollection\('planos_alimentares', {) Tj T* (  validationLevel: 'strict', validationAction: 'error',) Tj T* (  validator: { $jsonSchema: {) Tj T* (    bsonType: 'object',) Tj T* (    required: ['usuarioId', 'dataInicio', 'caloriasDiariasCif', 'proteinasGCif', 'carboidratosGCif', 'gordurasGCif', 'refeicoes'],) Tj T* (    additionalProperties: false,) Tj T* (    properties: {) Tj T* (      _id:                { bsonType: 'objectId' },) Tj T* (      usuarioId:          { bsonType: 'objectId' },) Tj T* (      dataInicio:         { bsonType: 'date' },) Tj T* (      objetivoCif:        { bsonType: 'binData' },) Tj T* (      caloriasDiariasCif: { bsonType: 'binData' },) Tj T* (      proteinasGCif:      { bsonType: 'binData' },) Tj T* (      carboidratosGCif:   { bsonType: 'binData' },) Tj T* (      gordurasGCif:       { bsonType: 'binData' },) Tj T* (      refeicoes: {) Tj T* (        bsonType: 'array', minItems: 1, maxItems: 12,      // multiplicidade 1..* da composi\001\002o) Tj T* (        items: {) Tj T* (          bsonType: 'object',) Tj T* (          required: ['refeicaoId', 'nome', 'horario', 'caloriasCif'],) Tj T* (          additionalProperties: false,) Tj T* (          properties: {) Tj T* (            refeicaoId:   { bsonType: 'objectId' },) Tj T* (            nome:         { bsonType: 'string', maxLength: 60, pattern: NAO_VAZIO },) Tj T* (            horario:      { bsonType: 'string', pattern: HORA },) Tj T* (            descricaoCif: { bsonType: 'binData' 