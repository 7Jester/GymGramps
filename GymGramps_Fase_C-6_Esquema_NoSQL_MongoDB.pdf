ng', maxLength: 120, pattern: NAO_VAZIO },) Tj T* (          dataNascimento: { bsonType: 'date' },) Tj T* (          pesoCif:        { bsonType: 'binData', description: '[S] peso em kg, cifrado \(RN-02\)' },) Tj T* (          senhaHash:      { bsonType: 'string', maxLength: 255 },) Tj T* (          tema:           { enum: ['CLARO', 'ESCURO'] },) Tj T* (          statusConta:    { enum: ['ATIVA', 'INATIVA'] },) Tj T* (          dataCadastro:   { bsonType: 'date' }) Tj T* (        } } },) Tj T* (    { $expr: { $gte: ['$dataNascimento', new Date\('1900-01-01T00:00:00Z'\)] } }) Tj T* (  ] }) Tj T* ET
