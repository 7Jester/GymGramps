BT 1 0 0 1 5 139.9 Tm /F5+0 6.4 Tf 7.7 TL (-- -----------------------------------------------------------------------------) Tj T* (-- 6. Regras que PK/FK/UNIQUE/CHECK n\002o expressam \(gatilhos\)) Tj T* (--    Fun\001\006es SECURITY DEFINER: precisam enxergar todas as linhas, mesmo com RLS.) Tj T* (-- -----------------------------------------------------------------------------) Tj T* (-- 6.1 Participante: no m\004ximo 2 por conversa e somente contas ATIVAS \(RN-01\)) Tj T* (CREATE FUNCTION fn_valida_participante\(\) RETURNS trigger) Tj T* (LANGUAGE plpgsql SECURITY DEFINER SET search_path = public, pg_temp AS) Tj T* ($$) Tj T* (BEGIN) Tj T* (  IF \(SELECT count\(*\) FROM participante_conversa) Tj T* (       WHERE id_conversa = NEW.id_conversa\) >= 2 THEN) Tj T* (    RAISE EXCEPTION 'A conversa j\004 possui 2 participantes';) Tj T* (  END IF;) Tj T* (  IF \(SELECT status_conta FROM usuario) Tj T* (       WHERE id_usuario = NEW.id_usuario\) <> 'ATIVA' THEN) Tj T* (    RAISE EXCEPTION 'Somente contas ATIVAS participam de conversas \(RN-01\)';) Tj T* (  END IF;) Tj T* (  RETURN NEW;) Tj T* (END $$;) Tj T* ET
Q
