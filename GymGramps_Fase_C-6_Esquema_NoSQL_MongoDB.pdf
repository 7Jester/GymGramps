BT 1 0 0 1 0 380.2 Tm /F4+0 5.9 Tf 7.15 TL (// =============================================================================) Tj T* (// GymGramps - Fase C-6 - Biblioteca da camada de aplica\001\002o \(carregada por 02 e 03 com load\(\)\)) Tj T* (// Faz no c\005digo o que, no PostgreSQL, eram gatilhos e fun\001\007es: cifragem \(RN-02\), regras que o) Tj T* (// $jsonSchema n\002o expressa \(sobreposi\001\002o, nomes \010nicos, contas ATIVAS, remetente participante\)) Tj T* (// e a exclus\002o em cascata \(RN-03\). No GymGramps real este c\005digo fica nos servi\001os da SPA/API.) Tj T* (// =============================================================================) Tj T* (const crypto = require\('crypto'\);) Tj T* (const bd = db.getSiblingDB\('gymgramps'\);) Tj T*  T* (// ---- Cifragem AES-256-GCM \(equivalente a fn_cifrar/fn_decifrar\). Chave de DEMONSTRA\013\014O:) Tj T* (//      em produ\001\002o vem de um gerenciador de segredos \(ou de Client-Side Field Level Encryption\).) Tj T* (const CHAVE = crypto.scryptSync\(process.env.GYMGRAMPS_CHAVE || 'chave-demo-gymgramps-nao-usar-em-producao',) Tj T* (                                'gymgramps-sal', 32\);) Tj T* (function cifrar\(valor\) {                          // texto -> BinData \(iv 12 B | tag 16 B | cifrado\)) Tj T* (  const iv = crypto.randomBytes\(12\);) Tj T* (  const c = crypto.createCipheriv\('aes-256-gcm', CHAVE, iv\);) Tj T* (  const ct = Buffer.concat\([c.update\(String\(valor\), 'utf8'\), c.final\(\)]\);) Tj T* (  return BinData\(0, Buffer.concat\([iv, c.getAuthTag\(\), ct]\).toString\('base64'\)\);) Tj T* (}) Tj T* (function decifrar\(bin\) {                          // BinData -> texto) Tj T* (  const b = Buffer.from\(bin.read\(0, bin.length\(\)\)\);) Tj T* (  const d = crypto.createDecipheriv\('aes-256-gcm', CHAVE, b.subarray\(0, 12\)\);) Tj T* (  d.setAuthTag\(b.subarray\(12, 28\)\);) Tj T* (  return Buffer.concat\([d.update\(b.subarray\(28\)\), d.final\(\)]\).toString\('utf8'\);) Tj T* (}) Tj T* (function hashSenha\(senha\) {                       // scrypt \(no Supabase, o Auth guarda o bcrypt\)) Tj T* (  const sal = crypto.randomBytes\(16\).toString\('hex'\);) Tj T* (  return 'scrypt$' + sal + '$' + crypto.scryptSync\(senha, sal, 32\).toString\('hex'\);) Tj T* (}) Tj T* (const dia = \(s\) => new Date\(s + 'T00:00:00Z'\);    // "2026-10-12" -> Date \(00:00 UTC\)) Tj T*  T* (// ---- Atividades: sem sobreposi\001\002o no mesmo dia \(a EXCLUDE do PostgreSQL\) --------------------) Tj T* (// At\015mico em um \010nico documento: o $push s\005 ocorre se NENHUMA atividade do dia se intercepta com) Tj T* (// [ini, fim\). Se houver sobreposi\001\002o o filtro n\002o casa, o upsert tenta criar o mesmo \(usuarioId, dia\)) Tj T* (// e o \003ndice \010nico uq_agenda_usuario_dia recusa \(E11000\). Atividades "encostadas" s\002o permitidas.) Tj T* (function agendarAtividade\(usuarioId, diaData, ini, fim, titulo, tipo\) {) Tj T* (  if \(!\(fim > ini\)\) throw new Error\('hora_fim deve ser maior que hora_inicio'\);) Tj T* (  const atv = { atividadeId: new ObjectId\(\), horaInicio: ini, horaFim: fim, titulo, tipo, concluida: false };) Tj T* (  try {) Tj T* (    bd.agendas_dia.updateOne\() Tj T* (      { usuarioId, dia: diaData, atividades: { $not: { $elemMatch: { horaInicio: { $lt: fim }, horaFim: { $gt: ini } } } } },) Tj T* (      { $push: { atividades: atv } }, { upsert: true }\);) Tj T* (  } catch \(e\) {) Tj T* (    if \(e.code === 11000\) throw new Error\('Atividade sobrep\007e outra do mesmo dia \(' + ini + '-' + fim + '\)'\);) Tj T* (    throw e;) Tj T* (  }) Tj T* (  return atv.atividadeId;) Tj T* (}) Tj T*  T* (// ---- Plano alimentar: refei\001\007es com nome \010nico e ao menos 1 refei\001\002o ------------------------) Tj T* (function adicionarRefeicao\(planoId, nome, horario, descricao, kcal\) {) Tj T* (  const r = bd.planos_alimentares.updateOne\() Tj T* (    { _id: planoId, 'refeicoes.nome': { $ne: nome } },                    // nome ainda n\002o usado no plano) Tj T* (    { $push: { refeicoes: { refeicaoId: new ObjectId\(\), nome, horario,) Tj T* ET
