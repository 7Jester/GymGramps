BT 1 0 0 1 5 147.6 Tm /F5+0 6.4 Tf 7.7 TL (-- -----------------------------------------------------------------------------) Tj T* (-- 7. Rotinas dos casos de uso \(executam em uma \012nica transa\001\002o\)) Tj T* (-- -----------------------------------------------------------------------------) Tj T* (-- UC-05 A1: cria a Conversa e as duas participa\001\006es na mesma transa\001\002o) Tj T* (CREATE FUNCTION criar_conversa\(p_usuario_a uuid, p_usuario_b uuid\) RETURNS uuid) Tj T* (LANGUAGE plpgsql SECURITY DEFINER SET search_path = public, pg_temp AS) Tj T* ($$) Tj T* (DECLARE v_id uuid;) Tj T* (BEGIN) Tj T* (  IF p_usuario_a = p_usuario_b THEN) Tj T* (    RAISE EXCEPTION 'Os participantes da conversa devem ser distintos';) Tj T* (  END IF;) Tj T* (  IF usuario_corrente\(\) IS NOT NULL AND usuario_corrente\(\) <> p_usuario_a THEN) Tj T* (    RAISE EXCEPTION 'Voc\003 s\011 pode iniciar conversas em seu pr\011prio nome';) Tj T* (  END IF;) Tj T* (  INSERT INTO conversa DEFAULT VALUES RETURNING id_conversa INTO v_id;) Tj T* (  INSERT INTO participante_conversa \(id_conversa, id_usuario\)) Tj T* (       VALUES \(v_id, p_usuario_a\), \(v_id, p_usuario_b\);) Tj T* (  RETURN v_id;) Tj T* (END $$;) Tj T* ET
