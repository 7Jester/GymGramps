BT 1 0 0 1 5 47.5 Tm /F5+0 6.4 Tf 7.7 TL (-- Hist\011rico de chat: /remetente e /conversa \(associa\001\006es derivadas\) via participante) Tj T* (CREATE VIEW vw_mensagem_historico WITH \(security_invoker = true\) AS) Tj T* (SELECT m.id_conversa, m.data_hora_envio, u.nome AS remetente, m.conteudo, m.status) Tj T* (  FROM mensagem m) Tj T* (  JOIN participante_conversa pc) Tj T* (    ON pc.id_conversa = m.id_conversa AND pc.id_usuario = m.id_remetente) Tj T* (  JOIN usuario u ON u.id_usuario = pc.id_usuario;) Tj T* ET
