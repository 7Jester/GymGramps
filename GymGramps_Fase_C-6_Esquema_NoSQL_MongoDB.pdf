BT 1 0 0 1 5 86 Tm /F5+0 6.4 Tf 7.7 TL (-- Cifra um texto \(AES-256, OpenPGP sim\005trico\). A chave vem da sess\002o e NUNCA) Tj T* (-- fica gravada no banco ou neste script \(em produ\001\002o: gerenciador de segredos\).) Tj T* (CREATE FUNCTION fn_cifrar\(p_valor text\) RETURNS bytea) Tj T* (LANGUAGE plpgsql STABLE AS) Tj T* ($$) Tj T* (DECLARE v_chave text := current_setting\('gymgramps.chave_cifra', true\);) Tj T* (BEGIN) Tj T* (  IF v_chave IS NULL OR v_chave = '' THEN) Tj T* (    RAISE EXCEPTION 'Chave de cifragem n\002o configurada \(gymgramps.chave_cifra\)';) Tj T* (  END IF;) Tj T* (  RETURN pgp_sym_encrypt\(p_valor, v_chave, 'cipher-algo=aes256'\);) Tj T* (END $$;) Tj T* ET
