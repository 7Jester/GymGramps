BT 1 0 0 1 5 124.5 Tm /F5+0 6.4 Tf 7.7 TL (-- -----------------------------------------------------------------------------) Tj T* (-- 5. \010ndices \(al\005m dos criados por PK, UNIQUE e EXCLUDE\)) Tj T* (--    Todos B-tree, exceto o GiST da restri\001\002o ex_atividade_sobreposicao.) Tj T* (-- -----------------------------------------------------------------------------) Tj T* (-- UC-05 A1: busca de usu\004rios ativos por nome \(\007ndice parcial: contas INATIVAS fora\)) Tj T* (CREATE INDEX ix_usuario_ativo_nome ON usuario \(nome\) WHERE status_conta = 'ATIVA';) Tj T* (-- UC-04: refei\001\006es do plano ordenadas por hor\004rio) Tj T* (CREATE INDEX ix_refeicao_plano_horario ON refeicao \(id_plano, horario\);) Tj T* (-- UC-05 passo 2: conversas de um usu\004rio \(a PK cobre apenas o sentido conversa->usu\004rio\)) Tj T* (CREATE INDEX ix_participante_usuario ON participante_conversa \(id_usuario\);) Tj T* (-- UC-05 passo 4: hist\011rico paginado por conversa, em ordem cronol\011gica) Tj T* (CREATE INDEX ix_mensagem_historico ON mensagem \(id_conversa, data_hora_envio\);) Tj T* (-- UC-05 E2: fila de reenvio \(\007ndice parcial, pequeno\)) Tj T* (CREATE INDEX ix_mensagem_pendentes ON mensagem \(id_conversa, id_remetente\)) Tj T* (  WHERE status = 'NAO_ENVIADA';) Tj T* (-- UC-03 \(atividades do dia por usu\004rio, ordenadas por hora_inicio\) j\004 \005 atendido) Tj T* (-- por uq_atividade \(id_usuario, data, hora_inicio\); n\002o precisa de \007ndice extra.) Tj T* ET
