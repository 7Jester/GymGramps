{
  "name": "gymgramps-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "GymGramps — frontend vanilla HTML/CSS/JS (migração pra React planejada após consolidar o design)",
  "scripts": {
    "build:css": "tailwindcss -i ./src/css/input.css -o ./src/css/output.css --minify",
    "watch:css": "tailwindcss -i ./src/css/input.css -o ./src/css/output.css --watch",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.1.0",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "type": "module"
}
